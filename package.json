{
  "name": "jobber-atlantis-docs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Improved replica of the Atlantis docs: menus, dropdowns, date pickers and drawers in live examples extend past the preview iframe",
  "scripts": {
    "assets": "node scripts/copy-docs.mjs && node scripts/build-editor-bundle.mjs",
    "predev": "npm run assets",
    "dev": "vite",
    "prebuild": "npm run assets",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@apollo/client": "3.13.8",
    "@babel/standalone": "7.26.2",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@jobber/components": "9.16.6",
    "@jobber/design": "0.121.0",
    "@jobber/hooks": "2.21.1",
    "@lezer/highlight": "1.2.5",
    "@lezer/javascript": "1.5.5",
    "@tanstack/react-table": "8.21.3",
    "axios": "1.20.0",
    "classnames": "2.5.1",
    "color": "4.2.3",
    "filesize": "6.4.0",
    "framer-motion": "11.18.2",
    "graphql": "16.11.0",
    "lodash": "4.17.21",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "10.1.0",
    "react-router-dom": "6.30.1",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/babel__standalone": "7.1.9",
    "@types/node": "24.5.2",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "esbuild": "0.25.12",
    "puppeteer-core": "25.12.0",
    "typescript": "5.9.2",
    "vite": "7.1.7"
  }
}
